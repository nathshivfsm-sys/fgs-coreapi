    "variable":  [
                     {
                         "key":  "apiVersion",
                         "value":  "v1"
                     }
                 ],
    "info":  {
                 "description":  "Tenant S3 provisioning and file upload workflow via {{gatewayUrl}}. Upload flow: 1) CreateUploadUrl 2) UploadFileToS3 (direct PUT to S3 presigned URL) 3) CompleteUpload.",
                 "name":  "FGS FileService",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
                 "_postman_id":  "0e70515a-9e4c-47bc-bed3-3766303649e0"
             },
    "event":  [
                  {
                      "script":  {
                                     "exec":  [
                                                  "if (pm.environment.get(\u0027tenantId\u0027)) {",
                                                  "  pm.request.headers.upsert({ key: \u0027X-Tenant-Id\u0027, value: pm.environment.get(\u0027tenantId\u0027) });",
                                                  "  pm.request.headers.upsert({ key: \u0027X-Company-Id\u0027, value: pm.environment.get(\u0027companyId\u0027) });",
                                                  "}"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "prerequest"
                  }
              ],
    "auth":  {
                 "bearer":  [
                                {
