                                                      "body":  {
                                                                   "raw":  "{\r\n  \"fileName\": \"company-logo.png\",\r\n  \"contentType\": \"image/png\",\r\n  \"fileSizeBytes\": 102400,\r\n  \"entityType\": \"COMPANY\",\r\n  \"entityId\": 1,\r\n  \"requestedVariant\": \"Logo\",\r\n  \"description\": \"Company logo upload\",\r\n  \"tags\": [\"logo\"]\r\n}",
