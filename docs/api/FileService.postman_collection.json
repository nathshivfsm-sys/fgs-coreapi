                                                                         "type":  "text",
                                                                         "value":  "{{companyId}}"
                                                                     },
                                                                     {
                                                                         "key":  "X-Tenant-Id",
                                                                         "type":  "text",
                                                                         "value":  "{{tenantId}}"
                                                                     }
                                                                 ],
                                                      "auth":  {
                                                                   "bearer":  [
                                                                                  {
                                                                                      "key":  "token",
                                                                                      "type":  "string",
                                                                                      "value":  "{{accessToken}}"
                                                                                  }
                                                                              ],
                                                                   "type":  "bearer"
                                                               }
                                                  }
                                  },
