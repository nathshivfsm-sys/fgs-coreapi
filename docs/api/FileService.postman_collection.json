{
    "item":  [
                 {
                     "description":  "File upload workflow (CreateUploadUrl → UploadFileToS3 → CompleteUpload), metadata, and company logo lookup via {{gatewayUrl}}.",
                     "name":  "FilesController",
                     "item":  [
                                  {
                                      "request":  {
                                                      "url":  {
                                                                  "host":  [
                                                                               "{{gatewayUrl}}"
                                                                           ],
                                                                  "raw":  "{{gatewayUrl}}/api/v1/files/upload-url",
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "files",
                                                                               "upload-url"
                                                                           ]
                                                              },
                                      "description":  "Step 1 of 3: Request a presigned S3 upload URL. Saves fileId, uploadUrl, and uploadContentType to the environment.",
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Accept",
                                                                         "type":  "text",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "X-Company-Id",
                                                                         "type":  "text",
                                                                         "value":  "{{companyId}}"
                                                                     },
                                                                     {
                                                                         "key":  "X-Tenant-Id",
                                                                         "type":  "text",
                                                                         "value":  "{{tenantId}}"
                                                                     },
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "type":  "text",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "raw":  "{\r\n  \"fileName\": \"company-logo.png\",\r\n  \"contentType\": \"image/png\",\r\n  \"fileSizeBytes\": 102400,\r\n  \"entityType\": \"Company\",\r\n  \"entityId\": {{companyId}},\r\n  \"requestedVariant\": \"full\",\r\n  \"description\": \"Company logo upload\",\r\n  \"tags\": []\r\n}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               },
                                                      "auth":  {
                                                                   "bearer":  [
                                                                                  {
                                                                                      "key":  "token",
                                                                                      "type":  "string",
                                                                                      "value":  "{{accessToken}}"
                                                                                  }
                                                                              ],
                                                                   "type":  "bearer"
                                                               }
                                                  },
                                      "name":  "CreateUploadUrl",
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const body = pm.response.json();",
                                                                                    "if (body.success \u0026\u0026 body.data) {",
                                                                                    "  if (body.data.fileId) {",
                                                                                    "    pm.environment.set(\"fileId\", String(body.data.fileId));",
                                                                                    "    pm.environment.set(\"recordId\", String(body.data.fileId));",
                                                                                    "  }",
                                                                                    "  if (body.data.uploadUrl) {",
                                                                                    "    pm.environment.set(\"uploadUrl\", body.data.uploadUrl);",
                                                                                    "  }",
                                                                                    "  if (body.data.requiredHeaders) {",
                                                                                    "    const headers = body.data.requiredHeaders;",
                                                                                    "    const contentType = headers[\"Content-Type\"] || headers[\"content-type\"] || \"image/png\";",
                                                                                    "    pm.environment.set(\"uploadContentType\", contentType);",
                                                                                    "  }",
                                                                                    "}"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "test"
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "UploadFileToS3",
                                      "request":  {
                                                      "method":  "PUT",
                                                      "auth":  {
                                                                   "type":  "noauth"
                                                               },
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "type":  "text",
                                                                         "value":  "{{uploadContentType}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "file",
                                                                   "file":  {

                                                                            }
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{uploadUrl}}"
                                                              },
                                                      "description":  "Step 2 of 3: PUT the file bytes directly to the presigned S3 URL from CreateUploadUrl. Body tab: binary — select company-logo.png (or matching content type). No Bearer token or tenant headers. Expect HTTP 200 from S3, then run CompleteUpload."
                                                  },
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "if (!pm.environment.get(\"uploadUrl\")) {",
                                                                                    "  throw new Error(\"Run CreateUploadUrl first to set uploadUrl.\");",
                                                                                    "}",
                                                                                    "const contentType = pm.environment.get(\"uploadContentType\") || \"image/png\";",
                                                                                    "pm.request.headers.upsert({ key: \"Content-Type\", value: contentType });"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "prerequest"
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "CompleteUpload",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  {
                                                                  "host":  [
                                                                               "{{gatewayUrl}}"
                                                                           ],
                                                                  "raw":  "{{gatewayUrl}}/api/v1/files/{{fileId}}/complete",
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "files",
                                                                               "{{fileId}}",
                                                                               "complete"
                                                                           ]
                                                              },
                                                      "description":  "Step 3 of 3: Finalize upload after S3 PUT succeeds. Generates the logo variant.",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Accept",
                                                                         "type":  "text",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "X-Company-Id",
                                                                         "type":  "text",
                                                                         "value":  "{{companyId}}"
                                                                     },
                                                                     {
                                                                         "key":  "X-Tenant-Id",
                                                                         "type":  "text",
                                                                         "value":  "{{tenantId}}"
                                                                     }
                                                                 ],
                                                      "auth":  {
                                                                   "bearer":  [
                                                                                  {
                                                                                      "key":  "token",
                                                                                      "type":  "string",
                                                                                      "value":  "{{accessToken}}"
                                                                                  }
                                                                              ],
                                                                   "type":  "bearer"
                                                               }
                                                  }
                                  },
                                  {
                                      "name":  "GetByEntity",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  {
                                                                  "query":  [
                                                                                {
                                                                                    "key":  "entityId",
                                                                                    "description":  "",
                                                                                    "value":  "{{companyId}}"
                                                                                },
                                                                                {
                                                                                    "key":  "entityType",
                                                                                    "description":  "",
                                                                                    "value":  "Company"
                                                                                }
                                                                            ],
                                                                  "host":  [
                                                                               "{{gatewayUrl}}"
                                                                           ],
                                                                  "raw":  "{{gatewayUrl}}/api/v1/files/by-entity",
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "files",
                                                                               "by-entity"
                                                                           ]
                                                              },
                                                      "description":  "GetByEntity",
                                                      "header":  [
