# Copy to terraform.tfvars (gitignored). Do not put live passwords or API keys in git.

aws_region  = "us-east-1"
environment = "dev"

github_org  = "nathshivfsm-sys"
github_repo = "fgs-coreapi"

# First apply: create ECR + IAM + ALB only, then push images, then set true.
create_ecs_services = false

image_tag     = "dev"
desired_count = 1

create_vpc = true
# vpc_id            = "vpc-xxxxxxxx"
# public_subnet_ids = ["subnet-aaa", "subnet-bbb"]

enable_alb                = true
use_fargate_spot          = false
enable_container_insights = false
log_retention_days        = 14

acm_certificate_arn = ""

aspnetcore_environment = "Development"

create_redis_rabbitmq = true

setup_db_connection_string = ""
# Only when create_redis_rabbitmq = false:
# redis_connection_string    = ""
# rabbitmq_host              = ""
# rabbitmq_connection_uri    = ""

kms_key_arn = ""

# Datadog ApiKey lives in Setup glo.GloCredential. Do not set Datadog__ApiKey on the task.

# If this account already has GitHub OIDC:
# create_github_oidc_provider = false
# github_oidc_provider_arn    = "arn:aws:iam::ACCOUNT:oidc-provider/token.actions.githubusercontent.com"
