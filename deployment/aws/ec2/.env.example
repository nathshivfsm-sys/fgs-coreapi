# EC2 only — copy to /opt/fgs/.env on the instance. Do not use for local Docker Desktop.
# deploy-service.sh updates FGS_*_IMAGE when you deploy.

FGS_CONFIG_DIR=/opt/fgs/config
FGS_ECR_REGISTRY=286093098927.dkr.ecr.us-east-1.amazonaws.com
FGS_ECR_REPO=fgs/dockers
FGS_CHANNEL=dev

ASPNETCORE_ENVIRONMENT=Development

# RabbitMQ container boot — must match glo.GloCredential Global:RABBITMQ Username/Password
RABBITMQ_USER=fgs
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD

CREDENTIAL_DISTRIBUTION_KEY=fgs-internal-credential-distribution-key

# Public gateway URL for invite emails / API deep links (no trailing slash).
FGS_PUBLIC_BASE_URL=https://api-dev.fieldwhizey.com
# Service path prefix for EC2 nginx routes (omit on local flat /api/v1/...).
FGS_PUBLIC_SERVICE_PATH=user-service

# Nginx TLS host (mounted certs: /opt/fgs/certs/tls.crt + tls.key for *.fieldwhizey.com)
NGINX_SERVER_NAME=api-dev.fieldwhizey.com

# Entra OAuth redirect_uri (login + invite). Must match an Entra External ID redirect URI.
# Maps to Application:UiAuthCallbackUrl on user-service.
#
# Option A — SPA redeems the code (SPA redirect URI type):
#   FGS_UI_AUTH_CALLBACK_URL=https://YOUR_SPA_HOST/auth/callback
#
# Option B — API callback (Web redirect URI); then set post-login SPA origin below:
#   FGS_UI_AUTH_CALLBACK_URL=https://api-dev.fieldwhizey.com/user-service/api/v1/auth/entra/callback
FGS_UI_AUTH_CALLBACK_URL=https://api-dev.fieldwhizey.com/user-service/api/v1/auth/entra/callback

# SPA origin after API Entra callback (token + refresh_token query). Maps to Application:UiPostLoginRedirectUrl.
# Required for Option B; ignored when the SPA handles /auth/callback itself.
FGS_UI_POST_LOGIN_REDIRECT_URL=https://v40ch9rg-4200.usw3.devtunnels.ms

# Set by deploy-service.sh (examples):
# FGS_SETUP_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:setup-dev
# FGS_AUDIT_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:audit-dev
# FGS_USER_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:user-dev
# FGS_BFF_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:bff-dev
# FGS_NOTIFICATION_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:notification-dev
# FGS_FILE_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:file-dev
# FGS_INVENTORY_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:inventory-dev
# FGS_ASSET_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:asset-dev
# FGS_CONSUMER_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:consumer-dev
# FGS_NGINX_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:nginx-dev
# FGS_REDIS_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:redis-dev
# FGS_RABBITMQ_IMAGE=286093098927.dkr.ecr.us-east-1.amazonaws.com/fgs/dockers:rabbitmq-dev

DD_ENV=dev
DD_SITE=datadoghq.com
