{
    "SetupService":  {
                         "BaseUrl":  "http://setup-service:5004"
                     },
    "CredentialDistribution":  {
                                   "InternalServiceKey":  ""
                               },
    "CredentialConsumer":  {
                               "ServiceName":  "fgs-consumer-service",
                               "RequiredProviders":  [
                                                         "RABBITMQ",
                                                         "REDIS"
                                                     ]
                           },
    "Redis":  {
                  "Enabled":  true,
                  "ConnectionString":  "",
                  "InstanceName":  "fgs-consumer:"
              },
    "NotificationService":  {
                                "BaseUrl":  "http://notification-service:5002"
                            },
    "AuditService":  {
                         "BaseUrl":  "http://audit-service:5008"
                     },
    "RabbitMq":  {
                     "HostName":  "localhost",
                     "Port":  5672,
                     "ExchangeName":  "fgs.user",
                     "EnsureQueuesOnStartup":  false
                 },
    "Consumer":  {
                     "Enabled":  true,
                     "PrefetchCount":  10,
                     "MaxRetryAttempts":  5,
                     "InitialRetryDelaySeconds":  5,
                     "Subscriptions":  [
                                           {
                                               "QueueName":  "Fgs.Setup.tenant.provision",
                                               "ExchangeName":  "tenant.events",
                                               "RoutingKey":  "tenant.provision.requested",
                                               "DeadLetterExchangeName":  "tenant.events.dlx",
                                               "DeadLetterQueueName":  "Fgs.Setup.tenant.provision.dlq",
                                               "DeadLetterRoutingKey":  "tenant.provision.dlq"
                                           },
                                           {
                                               "QueueName":  "fgs.user.notifications",
                                               "ExchangeName":  "fgs.user",
                                               "RoutingKey":  "user.CompanySignupInviteEmail",
                                               "DeadLetterExchangeName":  "fgs.user.dlx",
                                               "DeadLetterQueueName":  "fgs.user.notifications.dlq",
                                               "DeadLetterRoutingKey":  "user.notifications.dlq"
                                           },
                                           {
                                               "QueueName":  "Fgs.Audit.credential",
                                               "ExchangeName":  "audit.events",
                                               "RoutingKey":  "audit.credential.requested",
                                               "DeadLetterExchangeName":  "audit.events.dlx",
                                               "DeadLetterQueueName":  "Fgs.Audit.credential.dlq",
                                               "DeadLetterRoutingKey":  "audit.credential.dlq"
                                           }
                                       ]
                 },
    "Datadog":  {
                    "Enabled":  true,
                    "ApiKey":  "",
                    "Site":  "datadoghq.com",
                    "AgentHost":  "datadog-agent",
                    "AgentPort":  8126,
                    "DogStatsDPort":  8125,
                    "Env":  "local",
                    "Version":  "0.0.0",
                    "EnableApm":  true,
                    "EnableRuntimeMetrics":  true
                },
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft.AspNetCore":  "Warning",
                                                          "System":  "Warning"
                                                      }
                                     }
                },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*"
}
