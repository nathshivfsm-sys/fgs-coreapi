{
  "Notification": {
    "PlatformName": "FGS",
    "SupportEmail": "support@fgs.example",
    "CompanyName": "FGS",
    "InvitationExpirationHours": 72
  },
  "SendGrid": {
    "FromAddress": "fieldgoodservice@gmail.com",
    "FromName": "FGS Platform"
  },
  "TenantProviders": {
    "Default": {
      "Email": "SendGrid",
      "Sms": "Twilio",
      "Push": "Firebase"
    },
    "Tenants": {}
  },
  "FeatureFlags": {
    "Global": {
      "Notifications.Enabled": true
    },
    "Tenants": {}
  },
  "NotificationWorker": {
    "MaxRetryAttempts": 5,
    "RetryDelaySeconds": 10,
    "PrefetchCount": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-notification-service",
    "RequiredProviders": [ "DATABASE", "SENDGRID" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
