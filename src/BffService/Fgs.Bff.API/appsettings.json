{
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "Resilience": {
    "Http": {
      "MaxRetryAttempts": 3,
      "RetryDelaySeconds": 1,
      "AttemptTimeoutSeconds": 30,
      "TotalRequestTimeoutSeconds": 90,
      "CircuitBreakerFailureRatio": 50,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerBreakDurationSeconds": 30,
      "CircuitBreakerSamplingDurationSeconds": 60
    }
  },
  "CredentialDistribution": {
    "InternalServiceKey": ""
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-bff-service",
    "RequiredProviders": [
      "ENTRA_EXTERNAL_ID",
      "REDIS"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
