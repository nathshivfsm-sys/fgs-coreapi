{
  "ConnectionStrings": {
    "FgsSetup": "Host=YOUR_RDS_HOST;Port=5432;Database=fgs_dev_db;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "FileService": {
    "BaseUrl": "http://file-service:5005"
  },
  "AuditOutbox": {
    "Enabled": true
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "RabbitMq": {
    "EnsureQueuesOnStartup": false
  },
  "AwsCredentials": {
    "Region": "us-east-1",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "KmsKeyArn": "arn:aws:kms:us-east-1:ACCOUNT_ID:key/YOUR_CMK_ID",
    "EnableLocalProfileFallback": true,
    "EnableTestSecretEndpoint": true,
    "DefaultVaultProvider": "Database"
  },
  "AwsBootstrap": {
    "SecretId": "",
    "Region": ""
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "Swagger": {
    "Enabled": true
  },
  "Datadog": {
    "Enabled": true,
    "ApiKey": "",
    "Site": "datadoghq.com",
    "AgentHost": "datadog-agent",
    "AgentPort": 8126,
    "DogStatsDPort": 8125,
    "Env": "local",
    "Version": "0.0.0",
    "EnableApm": true,
    "EnableRuntimeMetrics": true,
    "EnableLlmObs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
