{
  "ConnectionStrings": {
    "FgsSetup": "Host=YOUR_RDS_HOST;Port=5432;Database=fgs_dev_db;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UserService": {
    "BaseUrl": "http://localhost:5001"
  },
  "FileService": {
    "BaseUrl": "http://localhost:5072"
  },
  "AuditOutbox": {
    "Enabled": true
  },
  "AwsCredentials": {
    "Region": "us-east-1",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "KmsKeyArn": "arn:aws:kms:us-east-1:ACCOUNT_ID:key/YOUR_CMK_ID",
    "EnableLocalProfileFallback": true,
    "EnableTestSecretEndpoint": true,
    "DefaultVaultProvider": "Database"
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "Resilience": {
    "Http": {
      "AttemptTimeoutSeconds": 60,
      "TotalRequestTimeoutSeconds": 120,
      "CircuitBreakerSamplingDurationSeconds": 120
    }
  }
}
