{
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": ""
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-scheduling-service",
    "RequiredProviders": [
      "DATABASE"
    ]
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
