{
  "EntraExternalId": {
    "TenantId": "f9417a96-cb71-4919-8332-7087f1ad0455",
    "ClientId": "3c788340-59a5-4864-b1b4-4f9adeffcb37",
    "Authority": "https://fsdemoapp.ciamlogin.com"
  },
  "FileService": {
    "PublicBaseUrl": "https://developer.fsm.com",
    "UploadUrlExpiryMinutes": 15,
    "DownloadUrlExpiryMinutes": 15,
    "MaxUploadSizeBytes": 104857600,
    "StreamCacheControlMaxAgeSeconds": 3600
  },
  "AttachmentValidation": {
    "AllowedExtensions": [
      ".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp",
      ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".zip", ".mp4", ".mp3", ".wav", ".txt", ".csv"
    ],
    "AllowedContentTypes": [
      "image/jpeg", "image/png", "image/webp", "image/gif", "image/bmp", "image/svg+xml",
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/zip", "application/x-zip-compressed",
      "video/mp4", "audio/mpeg", "audio/wav", "audio/x-wav",
      "text/plain", "text/csv"
    ]
  },
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-file-service",
    "RequiredProviders": [ "DATABASE", "AWS" ]
  },
  "AwsCredentials": {
    "Region": "us-east-1",
    "BucketNamePrefix": "fgs-dev-tenant",
    "ApplicationSlug": "fsm",
    "EnableLocalProfileFallback": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
