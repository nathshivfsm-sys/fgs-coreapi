{
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": ""
  },
  "Outbox": {
    "MaxRetryCount": 5
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-inventory-service",
    "RequiredProviders": [
      "DATABASE"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
