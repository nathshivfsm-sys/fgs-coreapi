{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Resilience": {
    "Http": {
      "AttemptTimeoutSeconds": 60,
      "TotalRequestTimeoutSeconds": 120,
      "CircuitBreakerSamplingDurationSeconds": 120
    }
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "redis:6379",
    "InstanceName": "fgs:",
    "DefaultAbsoluteExpirationMinutes": 30
  }
}
