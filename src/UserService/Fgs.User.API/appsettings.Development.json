{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UserService": {
    "BaseUrl": "http://localhost:5001"
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "OtlpEndpoint": ""
  },
  "Resilience": {
    "Http": {
      "AttemptTimeoutSeconds": 60,
      "TotalRequestTimeoutSeconds": 120,
      "CircuitBreakerSamplingDurationSeconds": 120
    }
  }
}
