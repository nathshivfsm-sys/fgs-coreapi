{
  "Signup": {
    "DefaultTimeZone": "UTC",
    "DefaultCurrency": "USD"
  },
  "Invitation": {
    "ExpiryDays": 1,
    "InviteBaseUrl": "https://developer.fsm.com/api/v1/invite/start"
  },
  "Application": {
    "DashboardUrl": "https://developer.fsm.com/api/v1/dashboard"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "UserService": {
    "BaseUrl": "http://localhost:5001"
  },
  "Swagger": {
    "Enabled": false
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-user-service",
    "RequiredProviders": [
      "DATABASE",
      "ENTRA_EXTERNAL_ID",
      "AWS",
      "REDIS"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
