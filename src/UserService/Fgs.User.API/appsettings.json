{
  "Signup": {
    "DefaultTimeZone": "UTC",
    "DefaultCurrency": "USD"
  },
  "Invitation": {
    "ExpiryDays": 1,
    "InviteBaseUrl": "https://developer.fsm.com/api/v1/invite/start"
  },
  "Application": {
    "PublicBaseUrl": "https://developer.fsm.com",
    "UiAuthCallbackUrl": "https://developer.fsm.com/auth/callback"
  },
  "UserService": {
    "BaseUrl": "http://localhost:5001"
  },
  "Swagger": {
    "Enabled": false
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "RabbitMq": {
    "EnsureQueuesOnStartup": false
  },
  "CredentialDistribution": {
    "InternalServiceKey": ""
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-user-service",
    "RequiredProviders": [
      "DATABASE",
      "ENTRA_EXTERNAL_ID",
      "AWS",
      "REDIS",
      "RABBITMQ"
    ]
  },
  "Datadog": {
    "Enabled": true,
    "ApiKey": "",
    "Site": "datadoghq.com",
    "AgentHost": "datadog-agent",
    "AgentPort": 8126,
    "DogStatsDPort": 8125,
    "Env": "local",
    "Version": "0.0.0",
    "EnableApm": true,
    "EnableRuntimeMetrics": true,
    "EnableLlmObs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
