  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": "fgs-internal-credential-distribution-key"
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-publisher-service",
    "RequiredProviders": [ "DATABASE", "RABBITMQ" ]
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "RabbitMq": {
    "ConnectionUri": "",
    "HostName": "localhost",
    "Port": 5672,
    "SslEnabled": false,
    "ExchangeName": "fgs.user",
    "RoutingKeyPrefix": "user.",
    "ExchangeNames": [
      "fgs.user",
      "tenant.events",
      "fgs.user.dlx",
      "tenant.events.dlx"
    ],
    "EnsureQueuesOnStartup": true,
    "QueueBindings": [
      {
        "ExchangeName": "tenant.events",
        "QueueName": "Fgs.Setup.tenant.provision",
        "RoutingKey": "tenant.provision.requested",
        "DeadLetterExchangeName": "tenant.events.dlx",
        "DeadLetterQueueName": "Fgs.Setup.tenant.provision.dlq",
        "DeadLetterRoutingKey": "tenant.provision.dlq"
      },
      {
        "ExchangeName": "fgs.user",
        "QueueName": "fgs.user.notifications",
        "RoutingKey": "user.CompanySignupInviteEmail",
        "DeadLetterExchangeName": "fgs.user.dlx",
        "DeadLetterQueueName": "fgs.user.notifications.dlq",
        "DeadLetterRoutingKey": "user.notifications.dlq"
      }
    ]
  },
  "OutboxSources": {
    "Sources": [
      {
        "SourceKey": "tenant",
        "ConnectionStringName": "FgsUser",
        "Schema": "tenant",
        "Table": "TenantOutboxMessage"
      },
      {
        "SourceKey": "glo",
        "ConnectionStringName": "FgsSetup",
        "Schema": "glo",
        "Table": "GloOutboxMessage"
      },
      {
        "SourceKey": "setup",
        "ConnectionStringName": "FgsSetup",
        "Schema": "setup",
        "Table": "SetupOutboxMessage"
      },
      {
        "SourceKey": "crm",
        "ConnectionStringName": "FgsCrm",
        "Schema": "crm",
        "Table": "CrmOutboxMessage"
      },
      {
        "SourceKey": "inventory",
        "ConnectionStringName": "FgsInventory",
        "Schema": "inventory",
        "Table": "InventoryOutboxMessage"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
