{
  "UserService": {
    "BaseUrl": "http://user-service:5001"
  },
  "SetupService": {
    "BaseUrl": "http://setup-service:5004"
  },
  "CredentialDistribution": {
    "InternalServiceKey": ""
  },
  "CredentialConsumer": {
    "ServiceName": "fgs-publisher-service",
    "RequiredProviders": [
      "DATABASE",
      "RABBITMQ"
    ]
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "RabbitMq": {
    "ConnectionUri": "",
    "HostName": "localhost",
    "Port": 5672,
    "SslEnabled": false,
    "ExchangeName": "fgs.user",
    "RoutingKeyPrefix": "user.",
    "ExchangeNames": [
      "fgs.user",
      "tenant.events",
      "setup.events",
      "audit.events",
      "fgs.user.dlx",
      "tenant.events.dlx",
      "audit.events.dlx"
    ],
    "EnsureQueuesOnStartup": true,
    "QueueBindings": [
      {
        "ExchangeName": "tenant.events",
        "QueueName": "Fgs.Setup.tenant.provision",
        "RoutingKey": "tenant.provision.requested",
        "DeadLetterExchangeName": "tenant.events.dlx",
        "DeadLetterQueueName": "Fgs.Setup.tenant.provision.dlq",
        "DeadLetterRoutingKey": "tenant.provision.dlq"
      },
      {
        "ExchangeName": "fgs.user",
        "QueueName": "fgs.user.notifications",
        "RoutingKey": "user.CompanySignupInviteEmail",
        "DeadLetterExchangeName": "fgs.user.dlx",
        "DeadLetterQueueName": "fgs.user.notifications.dlq",
        "DeadLetterRoutingKey": "user.notifications.dlq"
      },
      {
        "ExchangeName": "audit.events",
        "QueueName": "Fgs.Audit.credential",
        "RoutingKey": "audit.credential.requested",
        "DeadLetterExchangeName": "audit.events.dlx",
        "DeadLetterQueueName": "Fgs.Audit.credential.dlq",
        "DeadLetterRoutingKey": "audit.credential.dlq"
      }
    ]
  },
  "OutboxSources": {
    "Sources": [
      {
        "SourceKey": "tenant",
        "ConnectionStringName": "FgsUser",
        "Schema": "tenant",
        "Table": "TenantOutboxMessage",
        "Enabled": true
      },
      {
        "SourceKey": "glo",
        "ConnectionStringName": "FgsSetup",
        "Schema": "glo",
        "Table": "GloOutboxMessage",
        "Enabled": true
      },
      {
        "SourceKey": "setup",
        "ConnectionStringName": "FgsSetup",
        "Schema": "setup",
        "Table": "SetupOutboxMessage",
        "Enabled": true
      },
      {
        "SourceKey": "crm",
        "ConnectionStringName": "FgsCrm",
        "Schema": "crm",
        "Table": "CrmOutboxMessage",
        "Enabled": true
      },
      {
        "SourceKey": "inventory",
        "ConnectionStringName": "FgsInventory",
        "Schema": "inventory",
        "Table": "InventoryOutboxMessage",
        "Enabled": true
      }
    ]
  },
  "Datadog": {
    "Enabled": true,
    "ApiKey": "",
    "Site": "datadoghq.com",
    "AgentHost": "datadog-agent",
    "AgentPort": 8126,
    "DogStatsDPort": 8125,
    "Env": "local",
    "Version": "0.0.0",
    "EnableApm": true,
    "EnableRuntimeMetrics": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
